{
  "name": "api-profiler-vscode",
  "displayName": "API Profiler",
  "description": "See how fast your API routes actually are, next to where they are written.",
  "version": "0.0.0",
  "private": true,
  "publisher": "nahid625",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "API Profiler",
      "properties": {
        "apiProfiler.port": {
          "type": "number",
          "default": 4780,
          "description": "Port of the local channel the app opens (profiler({ channel: { port } }))."
        },
        "apiProfiler.thresholds.fast": {
          "type": "number",
          "default": 200,
          "description": "Average latency in ms below which a route is shown green."
        },
        "apiProfiler.thresholds.warn": {
          "type": "number",
          "default": 500,
          "description": "Average latency in ms below which a route is shown yellow; red from here."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiProfiler",
          "title": "API Profiler",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "apiProfiler": [
        {
          "id": "apiProfiler.routes",
          "name": "Routes"
        }
      ]
    },
    "commands": [
      {
        "command": "apiProfiler.refresh",
        "title": "API Profiler: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "apiProfiler.clearMetrics",
        "title": "API Profiler: Clear Metrics",
        "icon": "$(clear-all)"
      },
      {
        "command": "apiProfiler.showRoutes",
        "title": "API Profiler: Show Routes"
      },
      {
        "command": "apiProfiler.showStatus",
        "title": "API Profiler: Show Status"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apiProfiler.refresh",
          "when": "view == apiProfiler.routes",
          "group": "navigation@1"
        },
        {
          "command": "apiProfiler.clearMetrics",
          "when": "view == apiProfiler.routes",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --log-level=warning"
  },
  "dependencies": {
    "api-profiler": "^0.0.0"
  },
  "devDependencies": {
    "@api-profiler/core": "^0.0.0",
    "@api-profiler/node": "^0.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}

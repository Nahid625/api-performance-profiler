{
  "name": "api-profiler-vscode",
  "displayName": "API Performance Profiler",
  "description": "See how fast your API routes actually are, next to where they are written.",
  "version": "0.1.0",
  "publisher": "nahid625",
  "license": "AGPL-3.0-only",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nahid625/api-performance-profiler.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/Nahid625/api-performance-profiler#readme",
  "bugs": "https://github.com/Nahid625/api-performance-profiler/issues",
  "keywords": [
    "api",
    "performance",
    "profiler",
    "latency",
    "load test",
    "express",
    "nestjs",
    "node"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Testing",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "API Profiler",
      "properties": {
        "apiProfiler.port": {
          "type": "number",
          "default": 4780,
          "description": "Port of the local channel the app opens (profiler({ channel: { port } }))."
        },
        "apiProfiler.decorations": {
          "type": "boolean",
          "default": true,
          "description": "Show each route's latency at the end of the line where it is declared."
        },
        "apiProfiler.load.connections": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Concurrent connections a load test opens against your app."
        },
        "apiProfiler.load.duration": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Seconds a load test runs."
        },
        "apiProfiler.thresholds.fast": {
          "type": "number",
          "default": 200,
          "description": "Average latency in ms below which a route is shown green."
        },
        "apiProfiler.thresholds.warn": {
          "type": "number",
          "default": 500,
          "description": "Average latency in ms below which a route is shown yellow; red from here."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiProfiler",
          "title": "API Profiler",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "apiProfiler": [
        {
          "id": "apiProfiler.routes",
          "name": "Routes"
        }
      ]
    },
    "commands": [
      {
        "command": "apiProfiler.refresh",
        "title": "API Profiler: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "apiProfiler.clearMetrics",
        "title": "API Profiler: Clear Metrics",
        "icon": "$(clear-all)"
      },
      {
        "command": "apiProfiler.showRoutes",
        "title": "API Profiler: Show Routes"
      },
      {
        "command": "apiProfiler.showStatus",
        "title": "API Profiler: Show Status"
      },
      {
        "command": "apiProfiler.toggleDecorations",
        "title": "API Profiler: Toggle Inline Latency"
      },
      {
        "command": "apiProfiler.loadTest",
        "title": "API Profiler: Load Test Route"
      },
      {
        "command": "apiProfiler.explainLoadTest",
        "title": "API Profiler: Why Can't I Load Test This Route?"
      },
      {
        "command": "apiProfiler.install",
        "title": "API Profiler: Install @api-profiler/express"
      },
      {
        "command": "apiProfiler.addMiddleware",
        "title": "API Profiler: Add app.use(profiler()) to your app"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apiProfiler.refresh",
          "when": "view == apiProfiler.routes",
          "group": "navigation@1"
        },
        {
          "command": "apiProfiler.clearMetrics",
          "when": "view == apiProfiler.routes",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.js --log-level=warning",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "api-profiler": "^0.1.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@api-profiler/core": "^0.1.0",
    "@api-profiler/node": "^0.1.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.0"
  }
}

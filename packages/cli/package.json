  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nahid625/api-performance-profiler.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Nahid625/api-performance-profiler#readme",
